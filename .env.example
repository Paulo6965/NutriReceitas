# Copie para .env e preencha no computador local.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# IA do NutriChef: "gemini" (nuvem, plano gratuito) ou "ollama" (local).
# Se ficar vazio, usa Gemini quando houver GEMINI_API_KEY; senão, Ollama.
LLM_PROVIDER=gemini

# Chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Só usado com LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b

PORT=5500
